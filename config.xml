<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <!-- Имя NuGet-пакета, зависимости которого анализируются -->
  <Package>Newtonsoft.Json</Package>

  <!-- Для реального режима: адрес NuGet flat-container API -->
  <Repository>https://api.nuget.org/v3-flatcontainer/</Repository>

  <!-- true = тестовый XML-репозиторий; false = NuGet -->
  <TestMode>false</TestMode>

  <!-- Параметры отображения -->
  <AsciiTree>true</AsciiTree>
  <ShowLoadOrder>true</ShowLoadOrder>

  <!-- 0 = только прямые зависимости -->
  <MaxDepth>3</MaxDepth>

  <!-- Не учитывать пакеты, содержащие эту подстроку; пустое значение отключает фильтр -->
  <ExcludeSubstring></ExcludeSubstring>
</Configuration>
